# ============================================================
# Lead Intelligence Pipeline — Environment Variables (Example)
# ============================================================
# Most credentials are stored INSIDE n8n's credential manager,
# not here. This file documents what each integration needs
# so you can set them up cleanly before importing the workflow.
# ============================================================


# ── Apify ───────────────────────────────────────────────────
# Get your token at: console.apify.com/account/integrations
# In n8n: create an HTTP Header Auth credential with:
#   Header name:  Authorization
#   Header value: Bearer YOUR_APIFY_TOKEN
APIFY_TOKEN=your-apify-token


# ── Anthropic ───────────────────────────────────────────────
# Get your key at: console.anthropic.com/settings/keys
# In n8n: create an HTTP Header Auth credential with:
#   Header name:  x-api-key
#   Header value: YOUR_ANTHROPIC_KEY
# (and a second header: anthropic-version = 2023-06-01)
ANTHROPIC_API_KEY=your-anthropic-key


# ── Google Sheets ───────────────────────────────────────────
# Connect via OAuth2 inside n8n — no manual key needed
# The sheet ID is configured in the workflow's "Set Config" node
GOOGLE_SHEET_ID=your-sheet-id


# ── Telegram ────────────────────────────────────────────────
# Create a bot via @BotFather, save the token, and start a chat with it
# Get your chat ID from: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id


# ── Workflow tuning (optional) ──────────────────────────────
# These all live in the "Set Config" node — change them there, not here
MAX_RESULTS_PER_QUERY=40
HIGH_SCORE_THRESHOLD=8
MEDIUM_SCORE_THRESHOLD=5
ANTHROPIC_MODEL=claude-haiku-4-5
